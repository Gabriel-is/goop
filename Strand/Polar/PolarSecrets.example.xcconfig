// LOCAL XCODE BUILDS ONLY. Copy to PolarSecrets.xcconfig (gitignored, so NEVER commit the real one) and
// fill in your own Polar AccessLink client from https://admin.polaraccesslink.com.
// Steps: docs/polar-loop-morning-checklist.md.
//
// If you install GOOP from the fork's GitHub Actions release (the usual path), do NOT use this file.
// Those builds are public, and Info.plist values can be read by anyone. Type the client into
// Data Sources → Polar Loop instead; it is stored in the Keychain.
//
// The lane itself is already compiled in by PolarConfig.xcconfig, so this file only supplies values.
POLAR_CLIENT_ID = your_client_id_here
POLAR_CLIENT_SECRET = your_client_secret_here

// This must match a redirect URL registered on the client EXACTLY.
// xcconfig treats "//" as the start of a comment anywhere on a line. The empty $() splits it, and the
// value still resolves to noop://polar/callback.
// If the admin portal rejects a custom scheme, register http://localhost/polar/callback instead and set:
//   POLAR_REDIRECT_URI = http:/$()/localhost/polar/callback
// GOOP will then open Safari and ask you to paste the address you land on (see the checklist).
POLAR_REDIRECT_URI = noop:/$()/polar/callback
