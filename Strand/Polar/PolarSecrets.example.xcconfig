// Copy to PolarSecrets.xcconfig (gitignored — NEVER commit the real one) and fill in your own Polar
// AccessLink client's values from https://admin.polaraccesslink.com. Step-by-step:
// docs/polar-loop-morning-checklist.md.
//
// This line is what compiles the Polar Loop lane in (see PolarConfig.xcconfig):
OTHER_SWIFT_FLAGS = $(inherited) -DPOLAR_ACCESSLINK

// Leave these two blank for FIXTURE mode (sample data preview only, no network, no account).
POLAR_CLIENT_ID =
POLAR_CLIENT_SECRET =

// Must match a redirect URL registered on the client EXACTLY. xcconfig treats "//" as a comment start
// anywhere on a line, so the empty $() splits it — the value still resolves to noop://polar/callback.
// If the admin portal rejects a custom scheme, register http://localhost/polar/callback instead and set:
//   POLAR_REDIRECT_URI = http:/$()/localhost/polar/callback
// GOOP then opens Safari and asks you to paste the address you land on (see the checklist).
POLAR_REDIRECT_URI = noop:/$()/polar/callback
